FROM python:3.12-slim
WORKDIR /app
COPY api/requirements.lock.txt api/requirements-dev.txt /requirements/
RUN pip install --no-cache-dir -r /requirements/requirements.lock.txt -r /requirements/requirements-dev.txt
ENV PYTHONDONTWRITEBYTECODE=1
CMD ["python", "-m", "pytest", "-p", "no:cacheprovider", "-q"]
