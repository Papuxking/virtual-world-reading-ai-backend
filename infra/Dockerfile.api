FROM python:3.12-slim

WORKDIR /app

# --only-binary hace que la falta de rueda aarch64 falle de forma ruidosa
# en vez de intentar compilar desde fuente (ver checkpoint de bcrypt).
#
# Se instala desde requirements.lock.txt, NO desde requirements.txt. El lock
# fija las 36 versiones que se resolvieron en aarch64 el 18-ago-2026, que son
# exactamente las que corren en produccion. Instalando desde requirements.txt
# (sin pines) cada rebuild resolvia versiones frescas de PyPI: la imagen no
# era reproducible y un redespliegue podia traer una FastAPI o una SQLAlchemy
# distinta sin que nadie lo pidiera.
#
# requirements.txt sigue siendo la lista de dependencias DIRECTAS y es la que
# se edita para subir una version; despues se regenera el lock:
#   docker run --rm -v "$PWD/api:/api" -w /api python:3.12-slim sh -c \
#     "pip install --only-binary=:all: -q -r requirements.txt && pip freeze" \
#     > api/requirements.lock.txt
COPY api/requirements.lock.txt .
RUN pip install --no-cache-dir --only-binary=:all: -r requirements.lock.txt

COPY api/ .

EXPOSE 8000

# El healthcheck lo consume deploy.sh para decidir si promociona o revierte.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=4).status==200 else 1)"

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
